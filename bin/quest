#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml>=6"]
# ///
"""Quests and chores with staged review.

A quest moves through one flat machine of states, from draft goal to
evaluate goal. The agent writes each state's file and moves on; the creator
reviews and moves on. Every quest or chore is a directory under
docs/quests/STATE/, where STATE is active, backlog, completed, or abandoned,
holding quest.md and its stage files; the verbs move the directory when the
state changes. The quest log, docs/quests/README.md, is generated.
"""

import argparse
import json
import os
import shutil
import random
import re
import subprocess
import sys
from collections.abc import Callable
from dataclasses import dataclass
from datetime import UTC, date, datetime, time
from pathlib import Path

import yaml

FORMAT = 7
ROOT_NAME = "docs/quests"
PLUGIN_ROOT = Path(__file__).resolve().parents[1]
# Lowercase alphanumerics without the characters that read alike: 0 1 i l o.
ALPHABET = "23456789abcdefghjkmnpqrstuvwxyz"
ID_RE = re.compile(r"^\d{10}-[" + ALPHABET + "]{2}$")
SHAPE = re.compile(r"^\d{1,10}(-\S*)?$")   # an id prefix, or a directory-name prefix, which resolve accepts too
KINDS = ("quest", "chore")
BACKLOG, COMPLETED, ABANDONED = "backlog", "completed", "abandoned"
FINISHED = (COMPLETED, ABANDONED)
ACTIVE = "active"                           # the directory for every machine state
BUCKETS = (ACTIVE, BACKLOG, COMPLETED, ABANDONED)
GUIDANCE_DIR = "guidance"                   # docs/quests/guidance/STAGE.md: a project's own rules for a stage, read after the reference file
RESERVED = (*BUCKETS, GUIDANCE_DIR)         # names under docs/quests/ that are never an entry
HISTORY_LIMIT = 10
SLUG_MAX = 40
GENERATED_HEAD = "# Quest log\n"
HEADER_RE = re.compile(r"<!-- questlog format (\d+), written by questlog (\S+) on (\S+) -->")


@dataclass(frozen=True)
class State:
    name: str             # "review plan"
    file: str | None      # stage file that must exist before next, or None
    skippable: bool
    reviewer: str | None  # agent name, review states and evaluate goal
    record: str | None    # review record file
    reference: str        # file under skills/quest/references/
    doing: str            # gerund phrase, "reviewing the plan"; fills {next} in the previous state's say
    say: str              # printed after "ID is at NAME. "; {id} and {next} are filled
    nudge: bool = False   # print the memory write prompt on entry


STATES = (
    State("draft goal", "goal.md", False, None, None, "goal.md", "drafting the goal",
          "Write goal.md, then run: quest {id} next"),
    State("review goal", None, True, "review-goal", "goal-review.md", "goal.md", "reviewing the goal",
          "Run the review-goal loop into goal-review.md, then ask the creator: move on to {next}?"),
    State("research", "research.md", True, None, None, "research.md", "researching",
          "Write research.md, then run: quest {id} next"),
    State("review research", None, True, "review-research", "research-review.md", "research.md", "reviewing the research",
          "Run the review-research loop into research-review.md, then ask: move on to {next}?", nudge=True),
    State("design", "design.md", True, None, None, "design.md", "designing",
          "Write design.md, then run: quest {id} next"),
    State("review design", None, True, "review-design", "design-review.md", "design.md", "reviewing the design",
          "Run the review-design loop into design-review.md, then ask: move on to {next}?", nudge=True),
    State("plan", "plan.md", False, None, None, "plan.md", "planning",
          "Write plan.md, then run: quest {id} next"),
    State("review plan", None, True, "review-plan", "plan-review.md", "plan.md", "reviewing the plan",
          "Run the review-plan loop into plan-review.md, then ask: move on to {next}?", nudge=True),
    State("implement", None, False, None, None, "implement.md", "implementing",
          "Build in the order plan.md lists, then run: quest {id} next"),
    State("review implementation", None, True, "review-implement", "implement-review.md", "implement.md", "reviewing the implementation",
          "Run the review-implement loop into implement-review.md, then ask: move on to {next}?"),
    State("evaluate goal", None, False, "review-result", "result-review.md", "review.md", "evaluating the goal",
          "Run the review-result loop into result-review.md, then ask: is the goal met?"),
)
BY_NAME = {s.name: s for s in STATES}
CHORE_SKIPS = ("research", "review research", "design", "review design")
REVIEW_OF = {"research": "review research", "design": "review design"}   # skipping the key skips the value too

# one permission rule per creator verb; Claude Code prompts on a match in every mode, a `*` stands for any text in its place,
# and the rule does not look inside quoted text. `abandon` ends in `*` because its reason follows the verb; `next` has a second rule for its flag.
ASK_RULES = ("Bash(quest init *)", "Bash(quest new *)",
             *(f"Bash(quest * {v})" for v in ("start", "defer", "next", "skip")),
             "Bash(quest * next --confirmed)", "Bash(quest * abandon *)")
SETTINGS = ".claude/settings.json"
CLAUDE_MD_MARK = "<!-- questlog -->"
CLAUDE_MD_PARAGRAPH = f"""
## Quests {CLAUDE_MD_MARK}

Work is tracked as quests and chores under `docs/quests/`. Run `quest log` to see what is open and `quest ID` to read one. The `quest` skill has the states and the verbs. You draft; the creator decides. Run a creator verb only when the creator asks, and show the command first.
"""

USAGE = """Usage:
  quest new "Title" [--chore] [--goal TEXT] [--done-when TEXT]   open a quest or chore in the backlog
  quest log                      what is open, one line each
  quest history [--all] [--limit N]   completed work, newest first; --all adds abandoned
  quest doctor [--fix] [--brief]  check the tracker; --fix migrates and repairs
  quest init                     create docs/quests, the CLAUDE.md paragraph, and the ask rules

  quest ID [show]                show a quest: its page, files, state, and guidance (id prefix ok)
  quest ID start                 leave the backlog; a deferred quest resumes where it was
  quest ID defer                 back to the backlog; the state is kept
  quest ID next [--confirmed]    the current state is done; enter the next one
  quest ID skip                  skip the current state; research and design take their review with them
  quest ID abandon "reason"      terminal; files stay, the entry leaves the log

States, in order: {states}
init, new, start, defer, next, skip, and abandon prompt the creator.
""".format(states=", ".join(s.name for s in STATES))


# --- where ------------------------------------------------------------------


def project_root() -> Path:
    """CLAUDE_PROJECT_DIR when the harness sets it, else the git toplevel of cwd."""
    env = os.environ.get("CLAUDE_PROJECT_DIR")
    if env:
        return Path(env).resolve()
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        die("not inside a git repository and CLAUDE_PROJECT_DIR is unset")
    return Path(out).resolve()


def quests_dir(root: Path) -> Path:
    return root / ROOT_NAME


def safe_write_path(base: Path, path: Path, what: str = ROOT_NAME) -> Path:
    """A path the script may write: inside `base`, and no symlink at or below `base` on the way. `what` names the base in the refusal.

    A cloned repository can carry a symlink at docs/quests/README.md, at a
    quest directory, at .claude/settings.json, or at CLAUDE.md. Following it
    would let a contributor make this script overwrite any file the user can
    write. Refuse instead.
    """
    rel = path.relative_to(base) if path.is_relative_to(base) else None
    if rel is None:
        die(f"refusing to write outside {what}: {path}")
    if base.is_symlink():
        die(f"refusing to write: {what} is a symlink")
    probe = base
    for part in rel.parts:
        probe = probe / part
        if probe.is_symlink():
            die(f"refusing to write through a symlink in {what}: {probe.relative_to(base)}")
    resolved = path.resolve() if path.exists() else path.parent.resolve() / path.name
    if not resolved.is_relative_to(base.resolve()):
        die(f"refusing to write outside {what}: {path}")
    return path


def plugin_commit() -> str:
    """The plugin's commit: from git in a checkout, else from the cache directory name."""
    try:
        out = subprocess.run(["git", "-C", str(PLUGIN_ROOT), "rev-parse", "--short", "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
        if out:
            return out
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass
    if re.fullmatch(r"[0-9a-f]{7,40}", PLUGIN_ROOT.name):
        return PLUGIN_ROOT.name[:7]
    return "unknown"


def die(msg: str, code: int = 1) -> None:
    print(f"quest: {msg}", file=sys.stderr)
    sys.exit(code)


def now_iso(now: datetime | None = None) -> str:
    return (now or datetime.now(UTC)).strftime("%Y-%m-%dT%H:%M:%SZ")


# --- identifiers ------------------------------------------------------------


def slugify(title: str, limit: int = SLUG_MAX) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:limit].rstrip("-")
    return slug or "untitled"


def new_id(existing: set[str], now: datetime | None = None, rng: random.Random | None = None) -> str:
    """UTC minute plus two random characters. Draw again if the id is taken."""
    stamp = (now or datetime.now(UTC)).strftime("%y%m%d%H%M")
    rng = rng or random.SystemRandom()
    for _ in range(len(ALPHABET) ** 2):
        candidate = f"{stamp}-{rng.choice(ALPHABET)}{rng.choice(ALPHABET)}"
        if candidate not in existing:
            return candidate
    die(f"every suffix for minute {stamp} is taken")


def existing_ids(qdir: Path) -> set[str]:
    return {d.name[:13] for d in entry_dirs(qdir) if ID_RE.match(d.name[:13])}


# --- where an entry lives ------------------------------------------------------


def entry_dirs(qdir: Path) -> list[Path]:
    """Every directory that may be an entry, sorted: the children of docs/quests/ that are not reserved names, and the children of each bucket."""
    if not qdir.is_dir():
        return []
    out = [p for p in qdir.iterdir() if p.is_dir() and p.name not in RESERVED]
    for bucket in BUCKETS:
        if (qdir / bucket).is_dir():
            out += [p for p in (qdir / bucket).iterdir() if p.is_dir()]
    return sorted(out)


def bucket(fm: dict) -> str | None:
    """The directory an entry belongs in, from its state; None for a state the machine does not know."""
    state = str(fm.get("state"))
    if state in BY_NAME:
        return ACTIVE
    return state if state in (BACKLOG, *FINISHED) else None


def home(qdir: Path, d: Path, fm: dict) -> Path:
    """Where the entry belongs; callers pass only an entry whose bucket is not None."""
    return qdir / str(bucket(fm)) / d.name


def misplaced(qdir: Path) -> list[tuple[Path, dict]]:
    """The loaded entries that do not sit in the bucket their state names. An entry at the root of docs/quests/ counts."""
    return [(d, fm) for d, fm in load_quests(qdir) if bucket(fm) and d.parent != qdir / str(bucket(fm))]


def at_root(qdir: Path) -> list[tuple[Path, dict]]:
    """The bucketed entries directly under docs/quests/: the format 6 layout."""
    return [(d, fm) for d, fm in load_quests(qdir) if bucket(fm) and d.parent == qdir]


def move_entry(qdir: Path, d: Path, fm: dict) -> Path:
    """Move the entry to the bucket its state names, and return where it is now. A target that exists refuses."""
    target = home(qdir, d, fm)
    if d == target:
        return d
    safe_write_path(qdir, d)
    safe_write_path(qdir, target)
    if os.path.lexists(target):
        die(f"refusing to move {d.name}: {log_link(target).rstrip('/')} exists")
    target.parent.mkdir(exist_ok=True)
    d.rename(target)
    return target


def place_entries(root: Path) -> int:
    """The doctor's repair for entries out of place: move each, then write the log. Returns how many moved."""
    qdir = tracker_gate(root)
    moved = 0
    for d, fm in misplaced(qdir):
        new = move_entry(qdir, d, fm)
        print(f"quest: {fm['id']} -> {new.parent.name}/", file=sys.stderr)
        moved += 1
    write_log(root)
    if moved:
        print(f"quest: moved {entries(moved)} into the directory named for the state", file=sys.stderr)
    return moved


# --- pages ------------------------------------------------------------------


def stamp_text(value):
    """YAML parses an unquoted stamp into a datetime or date. Render those as the script writes stamps, so every consumer sees one form."""
    if isinstance(value, datetime):
        return now_iso(value.astimezone(UTC) if value.tzinfo else value)
    if isinstance(value, date):
        return now_iso(datetime.combine(value, time.min))
    return value


def parse_page(text: str) -> tuple[dict, str]:
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---\n", 4)
    if end < 0:
        return {}, text
    fm = yaml.safe_load(text[4:end]) or {}
    fm = {k: stamp_text(v) for k, v in fm.items()} if isinstance(fm, dict) else {}
    if isinstance(fm.get("history"), list):
        fm["history"] = [{**e, "at": stamp_text(e.get("at"))} if isinstance(e, dict) else e for e in fm["history"]]
    return fm, text[end + 5 :]


class _Quoted(str):
    pass


yaml.add_representer(_Quoted, lambda d, v: d.represent_scalar("tag:yaml.org,2002:str", str(v), style="'"))


def _quote_stamp(v):
    return _Quoted(v) if isinstance(v, str) and re.match(r"^\d{4}-\d{2}-\d{2}T", v) else v


def render_page(fm: dict, body: str) -> str:
    out = {k: _quote_stamp(v) for k, v in fm.items()}
    if isinstance(out.get("history"), list):
        out["history"] = [{**e, "at": _quote_stamp(e.get("at"))} if isinstance(e, dict) else e for e in out["history"]]
    dumped = yaml.dump(out, sort_keys=False, allow_unicode=True, default_flow_style=False)
    return f"---\n{dumped}---\n{body if body.endswith(chr(10)) else body + chr(10)}"


def quest_body(goal: str, done_when: str) -> str:
    return f"## Goal\n\n{goal}\n\n## Done when\n\n{done_when}\n"


def load_quests(qdir: Path) -> list[tuple[Path, dict]]:
    out = []
    for d in entry_dirs(qdir):
        page = d / "quest.md"
        if d.is_symlink() or page.is_symlink():
            continue
        if page.is_file():
            try:
                fm, _ = parse_page(page.read_text(encoding="utf-8"))
            except (OSError, UnicodeDecodeError):
                continue                    # doctor names the page; every other verb works around it
            if fm.get("id"):
                out.append((d, fm))
    return out


# --- the machine -------------------------------------------------------------


def entry(at: str, state: str, skipped: bool = False, note: str | None = None) -> dict:
    e = {"state": state, "at": at}
    if skipped:
        e["skipped"] = True
    if note:
        e["note"] = note
    return e


def state_of(fm: dict) -> State | None:
    """The machine state the entry is at, or None for backlog and finished entries."""
    return BY_NAME.get(str(fm.get("state")))


def skipped(fm: dict) -> set[str]:
    return {str(e.get("state")) for e in fm.get("history") or [] if isinstance(e, dict) and e.get("skipped")}


def successor(fm: dict, name: str) -> str:
    """The next state after `name` that carries no skipped entry, or completed past the last one."""
    names = [s.name for s in STATES]
    skip = skipped(fm)
    for later in names[names.index(name) + 1 :]:
        if later not in skip:
            return later
    return COMPLETED


def last_entry(fm: dict) -> dict:
    h = fm.get("history") or []
    return h[-1] if h and isinstance(h[-1], dict) else {}


def current(history: list[dict]) -> str:
    """The state of the last entry that is not skipped."""
    return next((str(e["state"]) for e in reversed(history) if isinstance(e, dict) and not e.get("skipped")), BACKLOG)


def append_history(fm: dict, name: str, skipped: bool = False, note: str | None = None, at: str | None = None) -> list[dict]:
    return [*(fm.get("history") or []), entry(at or now_iso(), name, skipped, note)]
def predates_format_6(fm: dict) -> bool:
    """A page written by a plugin before format 6: the format 5 shape (five keys, a known kind, no history) or an older mark.

    A page that is neither, such as a hand-broken one, is not a format case; the doctor's frontmatter row names it."""
    if fm.get("state") == "done" or any(k.endswith("_closed") for k in fm) or "implement_drafted" in fm:
        return True
    return "history" not in fm and {"id", "title", "kind", "state", "created"} <= fm.keys() and fm.get("kind") in KINDS


def plural(n: int, noun: str) -> str:
    return f"{n} {noun}{'' if n == 1 else 's'}"


def entries(n: int) -> str:
    return f"{n} {'entry' if n == 1 else 'entries'}"


def resolve(qdir: Path, prefix: str) -> tuple[Path, dict]:
    matches = [(d, fm) for d, fm in load_quests(qdir) if str(fm["id"]).startswith(prefix) or d.name.startswith(prefix)]
    if not matches:
        die(f"no quest or chore matches {prefix!r}")
    if len(matches) > 1:
        die(f"{prefix!r} matches {len(matches)} entries: " + ", ".join(str(fm["id"]) for _, fm in matches))
    return matches[0]


def say(fm: dict) -> str:
    """The one state line: where the entry is, and what happens next."""
    qid = fm["id"]
    s = state_of(fm)
    if s:
        nxt = successor(fm, s.name)
        doing = BY_NAME[nxt].doing if nxt in BY_NAME else "completion"
        return f"{qid} is at {s.name}. " + s.say.format(id=qid, next=doing)
    if fm.get("state") == BACKLOG and fm.get("resume"):
        return f"{qid} is in the backlog, to resume at {fm['resume']}. Start it with: quest {qid} start"
    if fm.get("state") == BACKLOG:
        return f"{qid} is in the backlog as a {fm.get('kind', 'quest')}. Start it with: quest {qid} start"
    return f"{qid} is {fm.get('state')}."


# --- the quest log ----------------------------------------------------------


def header_line(commit: str, now: datetime | None = None) -> str:
    return f"<!-- questlog format {FORMAT}, written by questlog {commit} on {(now or datetime.now(UTC)):%Y-%m-%d} -->"


def state_cell(fm: dict) -> str:
    state = str(fm.get("state"))
    return f"{state}, resume at {fm['resume']}" if state == BACKLOG and fm.get("resume") else state


def log_rows(quests: list[tuple[Path, dict]]) -> list[tuple[str, ...]]:
    """(id, directory, kind, state, title) for open entries, newest first."""
    rows = [(d, fm) for d, fm in quests if fm.get("state") == BACKLOG or fm.get("state") in BY_NAME]
    rows.sort(key=lambda r: str(r[1]["id"]), reverse=True)
    return [table_row(d, fm, state_cell(fm)) for d, fm in rows]


def history_rows(quests: list[tuple[Path, dict]], include_abandoned: bool = False, limit: int = HISTORY_LIMIT) -> list[tuple[str, ...]]:
    """(id, directory, kind, state, finished date, title) for finished entries, newest finish first, at most `limit`."""
    states = FINISHED if include_abandoned else (COMPLETED,)
    rows = [(d, fm) for d, fm in quests if fm.get("state") in states]
    rows.sort(key=lambda r: (str(last_entry(r[1]).get("at", "")), str(r[1]["id"])), reverse=True)
    return [table_row(d, fm, str(fm.get("state")), str(last_entry(fm).get("at", ""))[:10]) for d, fm in rows[:limit]]


def log_link(d: Path) -> str:
    """The entry's directory relative to docs/quests/, with a trailing slash: `active/ID-slug/`, or `ID-slug/` for an entry at the root."""
    return f"{d.parent.name}/{d.name}/" if d.parent.name in BUCKETS else f"{d.name}/"


def table_row(d: Path, fm: dict, *cells: str) -> tuple[str, ...]:
    """(id, directory, kind, CELLS..., title)."""
    return (str(fm["id"]), log_link(d), str(fm.get("kind", "quest")), *cells, str(fm.get("title", "")))


def log_lines(quests: list[tuple[Path, dict]]) -> list[str]:
    """Markdown table rows, one per open entry. The id links to the directory. A pipe in a title is escaped."""
    def cell(title: str) -> str:
        return " ".join(title.split()).replace("|", "\\|")   # one line, pipes escaped
    return [f"| [{qid}]({link}) | {kind} | {state} | {cell(title)} |" for qid, link, kind, state, title in log_rows(quests)]


LOG_TABLE_HEAD = "| Id | Kind | State | Title |\n|---|---|---|---|"


def render_log(quests: list[tuple[Path, dict]], commit: str, now: datetime | None = None) -> str:
    lines = log_lines(quests)
    body = LOG_TABLE_HEAD + "\n" + "\n".join(lines) if lines else "Nothing open."
    return f"{GENERATED_HEAD}\n{header_line(commit, now)}\n\nOpen quests and chores, newest first. Generated; do not edit by hand.\n\n{body}\n"


LOG_HEADS = ("Id", "Kind", "State", "Title")
HISTORY_HEADS = ("Id", "Kind", "State", "Finished", "Title")


def terminal_table(rows: list[tuple[str, ...]], heads: tuple[str, ...] = LOG_HEADS) -> str:
    """Aligned columns for the terminal, no directory column."""
    cells = [(r[0], *r[2:]) for r in rows]
    widths = [max(len(h), *(len(c[i]) for c in cells)) for i, h in enumerate(heads[:-1])]
    def fmt(c):
        return "  ".join(v.ljust(widths[i]) for i, v in enumerate(c[:-1])) + "  " + c[-1]
    return "\n".join([fmt(heads), fmt(tuple("-" * w for w in widths) + ("-----",))] + [fmt(c) for c in cells])


def tracker_gate(root: Path) -> Path:
    """The tracker directory the script may write into, or die. A clone can link docs or docs/quests outside the project."""
    qdir = quests_dir(root)
    linked = linked_tracker(root)
    if linked:
        die(f"refusing to use {linked}: it is a symlink, and every verb may write or migrate through it")
    return qdir


def linked_tracker(root: Path) -> str | None:
    """The first of docs and docs/quests that is a symlink, relative to root, or None."""
    qdir = quests_dir(root)
    return next((str(p.relative_to(root)) for p in (qdir.parent, qdir) if p.is_symlink()), None)


def write_log(root: Path) -> Path:
    qdir = tracker_gate(root)
    qdir.mkdir(parents=True, exist_ok=True)
    path = safe_write_path(qdir, qdir / "README.md")
    if os.path.lexists(path) and read_format(qdir) is None:
        die(f"refusing to rewrite {ROOT_NAME}/README.md: it is not a quest log, or cannot be read")
    path.write_text(render_log(load_quests(qdir), plugin_commit()))
    return path


# --- format -----------------------------------------------------------------


def read_format(qdir: Path) -> int | None:
    """The format number in the quest log header. None when there is no log, or the file is not a quest log."""
    path = qdir / "README.md"
    if not path.is_file() or path.is_symlink():
        return None
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return None
    m = HEADER_RE.search(text)
    if m:
        return int(m.group(1))
    # only a file that is recognisably our log is treated as one; anything else is left alone
    return 0 if text.lstrip().startswith(GENERATED_HEAD.strip()) else None


SUB6 = "migrate with questlog format-6 first"
F6 = "run: quest doctor --fix"


def pre6_pages(qdir: Path) -> int:
    """How many of the tracker's pages predate format 6."""
    return sum(1 for _, fm in load_quests(qdir) if predates_format_6(fm))


def check_format(root: Path) -> None:
    """Refuse data newer than this script, and data older than it; the doctor migrates format 6, nothing migrates below that.

    The format number lives in the log header, but what changed between 6 and
    7 is where each quest.md sits, so with no header the pages and their
    places decide.
    """
    qdir = tracker_gate(root)          # every verb writes through here, so a linked docs or tracker is refused before anything is read or created
    if not qdir.exists():
        return
    found = read_format(qdir)
    if found is not None and found > FORMAT:
        die(f"this repository was last written by a newer questlog (format {found}, this is {FORMAT}); update the plugin", 2)
    if pre6_pages(qdir) or (found is not None and found < 6):
        die(f"this tracker is format {found if found is not None and found < 6 else 'below 6'}; {SUB6}", 2)
    if at_root(qdir) or found == 6:
        die(f"this tracker is format 6; {F6}", 2)


# --- init and doctor --------------------------------------------------------


def load_settings(root: Path) -> tuple[dict, str | None]:
    """The project settings and why they cannot take ask rules, or None. An absent file loads as {}; init creates it."""
    path = root / SETTINGS
    if path.parent.exists() and not path.parent.is_dir():
        return {}, f"{path.parent.name} is not a directory"
    if not os.path.lexists(path):
        return {}, None
    if not path.is_file():
        return {}, f"{SETTINGS} is not a file"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except OSError:
        return {}, f"{SETTINGS} cannot be read"
    except (json.JSONDecodeError, UnicodeDecodeError):
        return {}, f"{SETTINGS} is not valid JSON"
    if not isinstance(data, dict):
        return {}, f"{SETTINGS} is not a JSON object"
    perms = data.get("permissions", {})
    if not isinstance(perms, dict):
        return {}, f"{SETTINGS} permissions is not an object"
    if not isinstance(perms.get("ask", []), list):
        return {}, f"{SETTINGS} permissions.ask is not a list"
    return data, None


def missing_ask_rules(data: dict) -> list[str]:
    """The rules in ASK_RULES absent from the settings' permissions.ask."""
    present = data.get("permissions", {}).get("ask", [])
    return [r for r in ASK_RULES if r not in present]


def stale_ask_rules(data: dict) -> list[str]:
    """Rules for the quest command that an earlier plugin wrote and this one does not: any `Bash(quest ` rule not in ASK_RULES."""
    present = data.get("permissions", {}).get("ask", [])
    return [r for r in present if isinstance(r, str) and r.startswith("Bash(quest ") and r not in ASK_RULES]


def settings_gate(root: Path) -> tuple[Path, dict]:
    """The settings path the script may write and its content, or die: no symlink on the way, and a shape the rules fit."""
    path = safe_write_path(root, root / SETTINGS, "the project")
    data, problem = load_settings(root)
    if problem:
        die(f"{problem}; fix it by hand", 2)
    if path.is_file() and not os.access(path, os.W_OK) or not path.is_file() and path.parent.is_dir() and not os.access(path.parent, os.W_OK):
        die(f"{SETTINGS} cannot be written; fix the permissions by hand")
    return path, data


def write_ask_rules(path: Path, data: dict) -> list[str]:
    """Add the missing ask rules and drop the stale ones in the loaded settings, keeping every other key. Returns what was added."""
    missing, stale = missing_ask_rules(data), stale_ask_rules(data)
    if not missing and not stale:
        return []
    ask = data.setdefault("permissions", {}).setdefault("ask", [])
    ask[:] = [r for r in ask if r not in stale] + missing
    # keep the file's indent and its final newline, so the diff the creator commits is the rules and little else
    old = path.read_text(encoding="utf-8") if path.is_file() else "\n"
    m = re.search(r"^([ \t]+)\S", old, re.M)
    indent = m.group(1) if m else "  "
    try:
        path.parent.mkdir(exist_ok=True)
        path.write_text(json.dumps(data, indent=indent, ensure_ascii=False) + ("\n" if old.endswith("\n") else ""), encoding="utf-8")
    except OSError as e:
        die(f"{SETTINGS} cannot be written: {e.strerror}")
    return missing


def write_missing_ask_rules(root: Path) -> None:
    """The doctor's repair. Adding a prompt cannot loosen anything, so no creator verb is needed."""
    write_ask_rules(*settings_gate(root))


def cmd_init(rest: list[str]) -> None:
    no_args(rest, "init")
    root = project_root()
    qdir = quests_dir(root)
    # refuse before check_format, so a refused init leaves the tree as it found it.
    # CLAUDE.md is often a link to AGENTS.md; a link that stays inside the project is fine, one that leaves it is not.
    claude_md = root / "CLAUDE.md"
    if claude_md.is_symlink():
        target = claude_md.resolve()
        if not target.is_relative_to(root.resolve()):
            die(f"refusing to write through a symlink that leaves the project: CLAUDE.md -> {os.readlink(claude_md)}")
        rel = target.relative_to(root.resolve())
        # identity, not a string prefix: a case-insensitive filesystem reaches docs/quests as Docs/quests
        in_tracker = qdir.exists() and any(p.samefile(qdir) for p in (target, *target.parents) if p.exists())
        if not target.is_file() or target.suffix != ".md" or any(part.startswith(".") for part in rel.parts) or in_tracker:
            die(f"refusing to write CLAUDE.md through a link to {os.readlink(claude_md)}: not a markdown file of the project's own")
    try:
        text = claude_md.read_text(encoding="utf-8") if claude_md.is_file() else ""
    except (OSError, UnicodeDecodeError):
        die("CLAUDE.md is not UTF-8 or cannot be read; fix it by hand")
    tracker_gate(root)
    settings = settings_gate(root)
    check_format(root)
    made = []
    added = write_ask_rules(*settings)
    if added:
        made.append(f"{plural(len(added), 'ask rule')} in {SETTINGS}")
    if not qdir.is_dir():
        qdir.mkdir(parents=True)
        made.append(str(qdir.relative_to(root)) + "/")
    if not (qdir / "README.md").is_file():
        write_log(root)
        made.append(f"{ROOT_NAME}/README.md")
    if CLAUDE_MD_MARK not in text:
        claude_md.write_text(text.rstrip("\n") + "\n" + CLAUDE_MD_PARAGRAPH if text else CLAUDE_MD_PARAGRAPH.lstrip("\n"))
        made.append("CLAUDE.md paragraph")
    git_add(root, [ROOT_NAME, "CLAUDE.md", SETTINGS])
    print("initialized: " + ", ".join(made) if made else "already initialized; nothing changed")
    for ok, label, fix, _, _ in git_checks(root):
        if not ok:
            print(f"quest: {label} ({fix})")


def marked_section(text: str) -> str | None:
    """The CLAUDE.md section that carries the questlog mark: from its heading to the next heading or the end. None when unmarked."""
    lines = text.splitlines()
    start = next((i for i, line in enumerate(lines) if CLAUDE_MD_MARK in line), None)
    if start is None:
        return None
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
    return "\n".join(line.rstrip() for line in lines[start:end]).strip()


REQUIRED_KEYS = ("id", "title", "kind", "state", "history")
VALID_STATES = (BACKLOG, *FINISHED, *BY_NAME)
PERSISTED = (ROOT_NAME, SETTINGS, "CLAUDE.md")


def git_states(root: Path, paths: tuple[str, ...]) -> dict[str, str]:
    """One rev-parse, one check-ignore, one ls-files for every path together."""
    try:
        subprocess.run(["git", "-C", str(root), "rev-parse", "--is-inside-work-tree"], capture_output=True, check=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        return {p: "no-git" for p in paths}
    present = [p for p in paths if (root / p).exists()]
    ignored = set(subprocess.run(["git", "-C", str(root), "check-ignore", "--", *present], capture_output=True, text=True).stdout.split()) if present else set()
    tracked = set(subprocess.run(["git", "-C", str(root), "ls-files", "--", *present], capture_output=True, text=True).stdout.split()) if present else set()
    out = {}
    for p in paths:
        if p not in present:
            out[p] = "missing"
        elif p in ignored or p.rstrip("/") in ignored:
            out[p] = "ignored"
        elif any(t == p or t.startswith(p.rstrip("/") + "/") for t in tracked):
            out[p] = "tracked"
        else:
            out[p] = "untracked"
    return out


Row = tuple[bool, str, str, Callable[[Path], None] | None, tuple[str, ...]]


def row(ok: bool, label: str, fix: str = "", repair=None, detail: tuple[str, ...] = ()) -> Row:
    """A doctor row: whether the check holds, what it checked, what the creator runs when it fails, the function `doctor --fix` runs for it, and detail lines printed under it."""
    return ok, label, fix, repair, detail


def git_checks(root: Path) -> list[Row]:
    rows = []
    states = git_states(root, PERSISTED)
    for path in PERSISTED:
        state = states[path]
        if state == "no-git":
            return [row(False, "this directory is a git repository", f"git init, then commit {ROOT_NAME}/ and {SETTINGS}")]
        label = {"tracked": f"{path} is committed", "untracked": f"{path} is not committed", "ignored": f"{path} is ignored by git", "missing": f"{path} does not exist"}[state]
        fix = {"tracked": "", "untracked": f"git add {path} && git commit", "ignored": f"remove {path} from .gitignore, then git add it", "missing": "quest init"}[state]
        rows.append(row(state == "tracked", label, fix))
    return rows


def git_add(root: Path, paths: list[str]) -> None:
    try:
        subprocess.run(["git", "-C", str(root), "add", "--", *[p for p in paths if (root / p).exists()]], capture_output=True, check=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass


def regenerate_tracker(root: Path) -> None:
    """The doctor's repair for a stale tracker: place the entries and rewrite the log. A log that is not ours, or is newer, and pages below format 6 are left alone."""
    qdir = tracker_gate(root)
    found = read_format(qdir)
    if found is None and os.path.lexists(qdir / "README.md"):
        die(f"refusing to rewrite {ROOT_NAME}/README.md: it is not a quest log, or cannot be read")
    if found is not None and found > FORMAT:
        die(f"refusing to rewrite a log written by a newer questlog (format {found}, this is {FORMAT}); update the plugin", 2)
    pre6 = pre6_pages(qdir)
    if pre6:
        die(f"{plural(pre6, 'quest.md file')} {'predates' if pre6 == 1 else 'predate'} format 6; {SUB6}", 2)
    place_entries(root)                # writes the log too


def doctor_checks(root: Path) -> list[Row]:
    """Rows in the order they print. Pure; cmd_doctor prints, and runs the repairs the failed rows carry."""
    rows = []
    qdir = quests_dir(root)
    linked = linked_tracker(root)
    if linked:
        return [row(False, f"{linked} is a symlink; every verb refuses it", "fix it by hand")]
    if not qdir.is_dir():
        return [row(False, f"{ROOT_NAME}/ exists", "quest init")]
    found = read_format(qdir)
    quests = load_quests(qdir)
    pre6 = sum(1 for _, fm in quests if predates_format_6(fm))
    root_entries = at_root(qdir)
    if found is None and os.path.lexists(qdir / "README.md"):
        rows.append(row(False, f"{ROOT_NAME}/README.md is not a quest log, or cannot be read", "fix it by hand"))
    elif found is not None and found > FORMAT:
        rows.append(row(False, f"quest log format {found} is newer than this plugin's {FORMAT}", "update the plugin"))
    elif pre6 or (found is not None and found < 6):
        rows.append(row(False, f"{plural(pre6, 'quest.md file')} {'predates' if pre6 == 1 else 'predate'} format 6" if pre6 else f"quest log format {found} is below 6", SUB6))
    elif root_entries or found == 6:
        n = len(root_entries)
        label = f"tracker is format 6 ({entries(n)} at the root of {ROOT_NAME})" if found != FORMAT else f"{entries(n)} {'sits' if n == 1 else 'sit'} at the root of {ROOT_NAME} under a format {FORMAT} log"
        rows.append(row(False, label, "quest doctor --fix", regenerate_tracker, tuple(f"{fm['id']} -> {bucket(fm)}/" for _, fm in root_entries)))
    elif found is None:
        rows.append(row(False, "quest log exists", "quest doctor --fix", regenerate_tracker))
    else:
        rows.append(row(True, f"quest log format {found}"))
    format_ok = rows[-1][0]
    if format_ok:
        out_of_place = misplaced(qdir)
        detail = "; ".join(f"{fm['id']} ({d.parent.name}/ -> {bucket(fm)}/)" for d, fm in out_of_place)
        rows.append(row(not out_of_place, "every entry sits under the directory named for its state" + (f"; misplaced: {detail}" if detail else ""), "quest doctor --fix", place_entries))
    overlay_dir = qdir / GUIDANCE_DIR
    if overlay_dir.is_dir():
        references = {s.reference for s in STATES}
        stray = sorted(p.name for p in overlay_dir.iterdir() if p.name not in references)
        rows.append(row(not stray, f"{GUIDANCE_DIR}/ holds only STAGE.md files" + (f"; stray: {', '.join(stray)}" if stray else ""), "name overlays after a stage, or remove them"))
    bad = 0
    loaded = {d: fm for d, fm in quests}
    for d in entry_dirs(qdir):
        name = log_link(d).rstrip("/")
        page = d / "quest.md"
        if not page.is_file():
            rows.append(row(False, f"{name}/ has no quest.md", "add one or remove the directory")); bad += 1; continue
        if d not in loaded:
            rows.append(row(False, f"{name}/quest.md is not UTF-8 or cannot be read", "fix it by hand")); bad += 1; continue
        fm = loaded[d]
        if predates_format_6(fm):
            continue                                    # the format row counts these
        missing = [k for k in REQUIRED_KEYS if k not in fm]
        history = fm.get("history")
        history_ok = isinstance(history, list) and history and all(isinstance(e, dict) and e.get("state") and e.get("at") for e in history)
        if missing or fm.get("kind") not in KINDS or fm.get("state") not in VALID_STATES or not ID_RE.match(str(fm.get("id", ""))) or not history_ok:
            rows.append(row(False, f"{name}/quest.md frontmatter invalid" + (f", missing {', '.join(missing)}" if missing else ""), "fix the frontmatter")); bad += 1
        elif current(history) != fm["state"]:
            rows.append(row(False, f"{name}/quest.md state {fm['state']} disagrees with its history ({current(history)})", "fix the frontmatter")); bad += 1
        elif not d.name.startswith(str(fm["id"])):
            rows.append(row(False, f"{name}/ does not start with its id {fm['id']}", "rename the directory")); bad += 1
    rows.append(row(bad == 0, f"{len(quests)} quest.md files valid"))
    if format_ok:
        current_log = (qdir / "README.md").read_text()
        same = log_lines(quests) == [l for l in current_log.splitlines() if l.startswith("| [")]
        rows.append(row(same, "quest log matches the directories", "quest doctor --fix", regenerate_tracker))
    claude_md = root / "CLAUDE.md"
    try:
        claude_text = claude_md.read_text(encoding="utf-8") if claude_md.is_file() else ""
    except (OSError, UnicodeDecodeError):
        claude_text, section = "", None
        rows.append(row(False, "CLAUDE.md is not UTF-8 or cannot be read", "fix it by hand"))
    else:
        section = marked_section(claude_text)
        rows.append(row(section is not None, "CLAUDE.md has the quests paragraph", "quest init"))
    if section is not None:
        # the paragraph is a copy that only init writes; the plugin's wording moves on without it
        rows.append(row(section == marked_section(CLAUDE_MD_PARAGRAPH), "CLAUDE.md quests paragraph matches the plugin's", "review it against the wording `quest init` writes; edit by hand"))
    data, problem = load_settings(root)
    if problem:
        rows.append(row(False, problem, "fix it by hand"))
    else:
        missing, stale = missing_ask_rules(data), stale_ask_rules(data)
        wrong = missing or stale
        linked = (root / SETTINGS).is_symlink() or (root / ".claude").is_symlink()   # read through a link is fine; the write refuses it
        label = ("settings.json asks for every creator verb" + (f"; missing: {', '.join(missing)}" if missing else "")
                 + (f"; stale: {', '.join(stale)}" if stale else "") + ("; the file is a symlink" if wrong and linked else ""))
        rows.append(row(not wrong, label, "fix them by hand" if linked else "quest doctor --fix", None if linked else write_missing_ask_rules))
    rows.extend(git_checks(root))
    return rows


def cmd_doctor(rest: list[str]) -> None:
    p = argparse.ArgumentParser(prog="quest doctor")
    p.add_argument("--fix", action="store_true"); p.add_argument("--brief", action="store_true", help="one line, nothing if no tracker")
    args = p.parse_args(rest)
    root = project_root()
    qdir = quests_dir(root)
    if args.brief and not qdir.is_dir() and not linked_tracker(root):
        print("questlog: this repository has no docs/quests/. Ask the creator whether to set up quests here; if yes, run `quest init`.")
        return
    rows = doctor_checks(root)
    repairs = dict.fromkeys(repair for ok, _, _, repair, _ in rows if not ok and repair)
    refused = 0
    if args.fix and repairs:
        for repair in repairs:
            try:
                repair(root)               # a refused repair has said why on stderr; the others still run
            except SystemExit as e:
                refused = max(refused, int(e.code or 1))
        rows = doctor_checks(root)
    failed = [r for r in rows if not r[0]]
    if args.brief:
        if failed:
            print("questlog: " + "; ".join(f"{label} ({fix})" if fix else label for _, label, fix, _, _ in failed))
        else:
            n = len(log_lines(load_quests(qdir)))
            print(f"questlog: ok, {n} open. Run `quest log`.")
        sys.exit(0)
    for ok, label, fix, _, detail in rows:
        print(f"{'ok  ' if ok else 'FAIL'} {label}" + (f"  ({fix})" if not ok and fix else ""))
        for line in detail:
            print(f"     {line}")
    sys.exit(refused or (1 if failed else 0))


# --- memory ------------------------------------------------------------------


def memory_hits(query: str) -> list[str]:
    """Top three memory pages for a query, when the memory plugin is on PATH. Fail open."""
    if not shutil.which("memory"):
        return []
    try:
        proc = subprocess.run(["memory", "search", "--json", query], capture_output=True, text=True, timeout=8)
        rows = json.loads(proc.stdout[proc.stdout.find("["):]) if "[" in proc.stdout else []
    except (subprocess.SubprocessError, json.JSONDecodeError, OSError, ValueError):
        return []
    return [f"`memory read {r['filename']}` ({str(r.get('summary', ''))[:80]})" for r in rows[:3] if r.get("filename")]


def print_memory_hits(query: str) -> None:
    hits = memory_hits(query)
    if hits:
        print("memory: " + " · ".join(hits))


# --- guidance ---------------------------------------------------------------

REFERENCES = PLUGIN_ROOT / "skills" / "quest" / "references"


def print_guidance(fm: dict, root: Path) -> None:
    """The guidance lines for the current state; for a backlog entry, the state `start` would enter; nothing for a finished entry."""
    s = state_of(fm)
    if s is None and fm.get("state") == BACKLOG:
        s = BY_NAME.get(str(fm.get("resume"))) or STATES[0]
    if s is None:
        return
    print(f"guidance: {REFERENCES / s.reference}")
    if s.reviewer:
        print(f"reviewer: questlog:{s.reviewer}")
        print(f"record: {s.record}")
    overlay = quests_dir(root) / GUIDANCE_DIR / s.reference
    if overlay.is_file():
        print(f"overlay: {overlay}")


def last_verdict(d: Path, record: str) -> str | None:
    """The verdict line of the last pass in the review record, or None when there is no record."""
    path = d / record
    if not path.is_file():
        return None
    verdicts = [l.partition(":")[2].strip() for l in path.read_text().splitlines() if l.startswith("Verdict:")]
    return verdicts[-1] if verdicts else None


def update_quest(d: Path, changes: dict) -> dict:
    """Merge `changes` into the frontmatter; a None value in `changes` deletes that key. The body is kept."""
    page = safe_write_path(d.parent, d / "quest.md")
    fm, body = parse_page(page.read_text())
    fm = {k: v for k, v in {**fm, **changes}.items() if not (k in changes and v is None)}
    page.write_text(render_page(fm, body))
    return fm


# --- the verbs: quest ID VERB --------------------------------------------------


def no_args(rest: list[str], what: str) -> None:
    if rest:
        die(f"{what} takes no arguments: {' '.join(rest)}", 2)


def require_at_state(fm: dict) -> State:
    s = state_of(fm)
    if s is None:
        if fm.get("state") == BACKLOG:
            die(f"{fm['id']} is in the backlog; run: quest {fm['id']} start")
        die(f"{fm['id']} is {fm.get('state')}; nothing more happens to it")
    return s


def cmd_show(root: Path, d: Path, fm: dict, rest: list[str]) -> None:
    no_args(rest, "show")
    print(say(fm))
    print()
    sys.stdout.write((d / "quest.md").read_text())
    files = sorted(p.name for p in d.iterdir() if p.is_file() and p.name != "quest.md")
    print("\nstage files: " + (", ".join(files) if files else "none"))
    print_guidance(fm, root)
    print_memory_hits(str(fm.get("title", "")))


def cmd_start(root: Path, d: Path, fm: dict, rest: list[str]) -> None:
    no_args(rest, "start")
    if fm.get("state") != BACKLOG:
        die(f"{fm['id']} is {fm.get('state')}; only a backlog entry starts")
    target = str(fm.get("resume") or STATES[0].name)
    if target not in BY_NAME:
        die(f"{fm['id']} resumes at {target!r}, which is not a state; fix the frontmatter")
    fm = update_quest(d, {"state": target, "resume": None, "history": append_history(fm, target)})
    move_entry(quests_dir(root), d, fm)
    write_log(root)
    print(say(fm))
    print_guidance(fm, root)
    print_memory_hits(str(fm.get("title", "")))


def cmd_defer(root: Path, d: Path, fm: dict, rest: list[str]) -> None:
    """The reverse of start. The state is kept in `resume`, so `start` resumes the entry where it was."""
    no_args(rest, "defer")
    s = require_at_state(fm)
    fm = update_quest(d, {"state": BACKLOG, "resume": s.name, "history": append_history(fm, BACKLOG)})
    move_entry(quests_dir(root), d, fm)
    write_log(root)
    print(say(fm))


def cmd_next(root: Path, d: Path, fm: dict, rest: list[str]) -> None:
    if rest not in ([], ["--confirmed"]):
        die(f"next takes --confirmed or nothing: {' '.join(rest)}", 2)
    s = require_at_state(fm)
    if s.file and not (d / s.file).is_file():
        die(f"{d.name}/{s.file} does not exist yet")
    if s.reviewer:
        verdict = last_verdict(d, s.record)
        if verdict and not verdict.lower().startswith("converged") and not rest:
            die(f"last verdict: {verdict}\nconfirm with the creator, then run: quest {fm['id']} next --confirmed")
    nxt = successor(fm, s.name)
    # the page is written first and the directory follows it: an interruption between the two leaves a page whose
    # state names one bucket while it sits in another, which the doctor's placement row names and --fix moves
    fm = update_quest(d, {"state": nxt, "history": append_history(fm, nxt)})
    d = move_entry(quests_dir(root), d, fm)
    write_log(root)
    print(say(fm))
    if nxt in BY_NAME and BY_NAME[nxt].nudge and shutil.which("memory"):
        print(f"memory: what did you learn while {s.doing} on your own? One page per finding, `--ref {d.relative_to(root)}/{s.file}`, before the creator moves on.")


def cmd_skip(root: Path, d: Path, fm: dict, rest: list[str]) -> None:
    no_args(rest, "skip")
    s = require_at_state(fm)
    if not s.skippable:
        die(f"{s.name} cannot be skipped")
    at = now_iso()
    history = append_history(fm, s.name, skipped=True, at=at)
    if s.name in REVIEW_OF:
        history = append_history({"history": history}, REVIEW_OF[s.name], skipped=True, at=at)
    nxt = successor({"history": history}, s.name)
    history = append_history({"history": history}, nxt, at=at)
    fm = update_quest(d, {"state": nxt, "history": history})
    move_entry(quests_dir(root), d, fm)
    write_log(root)
    print(say(fm))


def cmd_abandon(root: Path, d: Path, fm: dict, rest: list[str]) -> None:
    if fm.get("state") in FINISHED:
        die(f"{fm['id']} is {fm['state']}; nothing more happens to it")
    reason = " ".join(rest).strip()
    if not reason:
        die("abandon needs a reason, in the creator's words")
    fm = update_quest(d, {"state": ABANDONED, "resume": None, "history": append_history(fm, ABANDONED, note=reason)})
    d = move_entry(quests_dir(root), d, fm)
    write_log(root)
    print(say(fm) + f" Files stay in {log_link(d)}.")


# --- commands: quest VERB ------------------------------------------------------


def cmd_new(rest: list[str]) -> None:
    p = argparse.ArgumentParser(prog="quest new")
    p.add_argument("title")
    p.add_argument("--chore", action="store_true", help="a small piece of work; research and design are skipped")
    p.add_argument("--goal", help="what the creator wants to accomplish")
    p.add_argument("--done-when", help="how we will know it is done")
    args = p.parse_args(rest)
    root = project_root()
    check_format(root)
    qdir = quests_dir(root)
    qdir.mkdir(parents=True, exist_ok=True)
    kind = "chore" if args.chore else "quest"
    safe_write_path(qdir, qdir / "README.md")      # refuse before creating anything if the log cannot be written
    qid = new_id(existing_ids(qdir))
    d = safe_write_path(qdir, qdir / BACKLOG / f"{qid}-{slugify(args.title)}")
    d.mkdir(parents=True)
    at = now_iso()
    history = [entry(at, BACKLOG)] + ([entry(at, n, skipped=True, note="chore") for n in CHORE_SKIPS] if kind == "chore" else [])
    fm = {"id": qid, "title": args.title, "kind": kind, "state": BACKLOG, "history": history}
    body = quest_body(args.goal or "(what the creator wants to accomplish)", args.done_when or "(how we will know)")
    (d / "quest.md").write_text(render_page(fm, body))
    write_log(root)
    print(say(fm))


def cmd_log(rest: list[str]) -> None:
    no_args(rest, "log")
    root = project_root()
    check_format(root)
    rows = log_rows(load_quests(quests_dir(root)))
    print(terminal_table(rows) if rows else "Nothing open.")


def cmd_history(rest: list[str]) -> None:
    p = argparse.ArgumentParser(prog="quest history")
    p.add_argument("--all", action="store_true", help="include abandoned entries")
    p.add_argument("--limit", type=int, default=HISTORY_LIMIT, metavar="N")
    args = p.parse_args(rest)
    if args.limit < 1:
        die("--limit must be at least 1")
    root = project_root()
    check_format(root)
    rows = history_rows(load_quests(quests_dir(root)), args.all, args.limit)
    print(terminal_table(rows, HISTORY_HEADS) if rows else "Nothing completed.")


GLOBAL = {"new": cmd_new, "log": cmd_log, "history": cmd_history, "doctor": cmd_doctor, "init": cmd_init}
VERBS = {"show": cmd_show, "start": cmd_start, "defer": cmd_defer, "next": cmd_next, "skip": cmd_skip, "abandon": cmd_abandon}


def main(argv: list[str] | None = None) -> None:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip() + "\n\n" + USAGE.rstrip())
        return
    head, rest = argv[0], argv[1:]
    if head in GLOBAL:
        GLOBAL[head](rest)
        return
    if not SHAPE.match(head):
        die(f"unknown command: {head}\n\n{USAGE.rstrip()}", 2)
    verb = rest[0] if rest else "show"
    if verb not in VERBS:
        die(f"unknown verb: {verb}; one of {', '.join(VERBS)}", 2)
    root = project_root()
    check_format(root)
    d, fm = resolve(quests_dir(root), head)
    VERBS[verb](root, d, fm, rest[1:])


if __name__ == "__main__":
    main()
