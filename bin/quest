#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml>=6"]
# ///
"""Quests and chores with staged review.

A quest runs goal, research, design, plan, implement, review. A chore runs
plan, implement, review. The agent drafts a stage and asks; the creator closes it.
Every quest or chore is a directory under docs/quests/ holding quest.md and
its stage files. The quest log, docs/quests/README.md, is generated.

Usage:
  quest init                        create docs/quests and the CLAUDE.md paragraph (creator verb)
  quest doctor [--fix] [--brief]    check the tracker; --fix regenerates a stale log
  quest log                         what is open, one line each
  quest show ID                     a quest's metadata and files (id prefix ok)
  quest new "Title" [--chore] [--goal TEXT] [--done-when TEXT]
  quest start ID                    backlog to active
  quest draft ID STAGE              the stage file is written and awaits review
                                    stages: goal research design plan implement review
  quest close ID STAGE              the creator accepted the stage; review sets done
  quest skip ID research            the creator waived research
  quest abandon ID "reason"         terminal; files stay, entry leaves the log

new, start, close, skip, and abandon are creator verbs: run them only when
the creator asked, and show the command first.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import random
import re
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path

import yaml

FORMAT = 3
ROOT_NAME = "docs/quests"
PLUGIN_ROOT = Path(__file__).resolve().parents[1]
# Lowercase alphanumerics without the characters that read alike: 0 1 i l o.
ALPHABET = "23456789abcdefghjkmnpqrstuvwxyz"
ID_RE = re.compile(r"^\d{10}-[" + ALPHABET + "]{2}$")
KINDS = ("quest", "chore")
STATES = ("backlog", "active", "done", "abandoned")
STAGES = {"quest": ("goal", "research", "design", "plan", "implement", "review"), "chore": ("plan", "implement", "review")}
SLUG_MAX = 40
GENERATED_HEAD = "# Quest log\n"
HEADER_RE = re.compile(r"<!-- questlog format (\d+), written by questlog (\S+) on (\S+) -->")
CLAUDE_MD_MARK = "<!-- questlog -->"
CLAUDE_MD_PARAGRAPH = f"""
## Quests {CLAUDE_MD_MARK}

Work is tracked as quests and chores under `docs/quests/`. Run `quest log` to see what is open and `quest show ID` to read one. The `quest` skill has the stage rules. You draft; the creator decides. Run `quest new`, `start`, `close`, `skip`, or `abandon` only when the creator asks, and show the command first.
"""


# --- where ------------------------------------------------------------------


def project_root() -> Path:
    """CLAUDE_PROJECT_DIR when the harness sets it, else the git toplevel of cwd."""
    env = os.environ.get("CLAUDE_PROJECT_DIR")
    if env:
        return Path(env).resolve()
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        die("not inside a git repository and CLAUDE_PROJECT_DIR is unset")
    return Path(out).resolve()


def quests_dir(root: Path) -> Path:
    return root / ROOT_NAME


def plugin_commit() -> str:
    """The plugin's commit: from git in a checkout, else from the cache directory name."""
    try:
        out = subprocess.run(["git", "-C", str(PLUGIN_ROOT), "rev-parse", "--short", "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
        if out:
            return out
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass
    if re.fullmatch(r"[0-9a-f]{7,40}", PLUGIN_ROOT.name):
        return PLUGIN_ROOT.name[:7]
    return "unknown"


def die(msg: str, code: int = 1) -> None:
    print(f"quest: {msg}", file=sys.stderr)
    sys.exit(code)


def now_iso(now: datetime | None = None) -> str:
    return (now or datetime.now(UTC)).strftime("%Y-%m-%dT%H:%M:%SZ")


# --- identifiers ------------------------------------------------------------


def slugify(title: str, limit: int = SLUG_MAX) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:limit].rstrip("-")
    return slug or "untitled"


def new_id(existing: set[str], now: datetime | None = None, rng: random.Random | None = None) -> str:
    """UTC minute plus two random characters. Draw again if the id is taken."""
    stamp = (now or datetime.now(UTC)).strftime("%y%m%d%H%M")
    rng = rng or random.SystemRandom()
    for _ in range(len(ALPHABET) ** 2):
        candidate = f"{stamp}-{rng.choice(ALPHABET)}{rng.choice(ALPHABET)}"
        if candidate not in existing:
            return candidate
    die(f"every suffix for minute {stamp} is taken")


def existing_ids(qdir: Path) -> set[str]:
    return {p.name[:13] for p in qdir.iterdir() if p.is_dir() and ID_RE.match(p.name[:13])} if qdir.is_dir() else set()


# --- pages ------------------------------------------------------------------


def parse_page(text: str) -> tuple[dict, str]:
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---\n", 4)
    if end < 0:
        return {}, text
    fm = yaml.safe_load(text[4:end]) or {}
    return (fm if isinstance(fm, dict) else {}), text[end + 5 :]


class _Quoted(str):
    pass


yaml.add_representer(_Quoted, lambda d, v: d.represent_scalar("tag:yaml.org,2002:str", str(v), style="'"))


def render_page(fm: dict, body: str) -> str:
    out = {k: (_Quoted(v) if isinstance(v, str) and re.match(r"^\d{4}-\d{2}-\d{2}T", v) else v) for k, v in fm.items()}
    dumped = yaml.dump(out, sort_keys=False, allow_unicode=True, default_flow_style=False)
    return f"---\n{dumped}---\n{body if body.endswith(chr(10)) else body + chr(10)}"


def quest_body(goal: str, done_when: str) -> str:
    return f"## Goal\n\n{goal}\n\n## Done when\n\n{done_when}\n"


def load_quests(qdir: Path) -> list[tuple[Path, dict]]:
    out = []
    if not qdir.is_dir():
        return out
    for d in sorted(qdir.iterdir()):
        page = d / "quest.md"
        if d.is_dir() and page.is_file():
            fm, _ = parse_page(page.read_text())
            if fm.get("id"):
                out.append((d, fm))
    return out


def current_stage(fm: dict) -> str | None:
    """First stage not closed or skipped, or None when the quest is finished."""
    for stage in STAGES.get(fm.get("kind", "quest"), STAGES["quest"]):
        if not fm.get(f"{stage}_closed") and not fm.get(f"{stage}_skipped"):
            return stage
    return None


def resolve(qdir: Path, prefix: str) -> tuple[Path, dict]:
    matches = [(d, fm) for d, fm in load_quests(qdir) if str(fm["id"]).startswith(prefix) or d.name.startswith(prefix)]
    if not matches:
        die(f"no quest or chore matches {prefix!r}")
    if len(matches) > 1:
        die(f"{prefix!r} matches {len(matches)} entries: " + ", ".join(str(fm["id"]) for _, fm in matches))
    return matches[0]


# --- the quest log ----------------------------------------------------------


def header_line(commit: str, now: datetime | None = None) -> str:
    return f"<!-- questlog format {FORMAT}, written by questlog {commit} on {(now or datetime.now(UTC)):%Y-%m-%d} -->"


def log_rows(quests: list[tuple[Path, dict]]) -> list[tuple[str, str, str, str, str, str]]:
    """(id, directory, kind, state, stage, title) for open entries, newest first."""
    rows = [(d, fm) for d, fm in quests if fm.get("state") in ("backlog", "active")]
    rows.sort(key=lambda r: str(r[1]["id"]), reverse=True)
    return [(str(fm["id"]), d.name, str(fm.get("kind", "quest")), str(fm.get("state")), current_stage(fm) or "closed", str(fm.get("title", ""))) for d, fm in rows]


def log_lines(quests: list[tuple[Path, dict]]) -> list[str]:
    """Markdown table rows, one per open entry. The id links to the directory. A pipe in a title is escaped."""
    return [f"| [{qid}]({dirname}/) | {kind} | {state} | {stage} | {title.replace('|', chr(92) + '|')} |" for qid, dirname, kind, state, stage, title in log_rows(quests)]


LOG_TABLE_HEAD = "| Id | Kind | State | Stage | Title |\n|---|---|---|---|---|"


def render_log(quests: list[tuple[Path, dict]], commit: str, now: datetime | None = None) -> str:
    lines = log_lines(quests)
    body = LOG_TABLE_HEAD + "\n" + "\n".join(lines) if lines else "Nothing open."
    return f"{GENERATED_HEAD}\n{header_line(commit, now)}\n\nOpen quests and chores, newest first. Generated; do not edit by hand.\n\n{body}\n"


def terminal_table(rows: list[tuple[str, str, str, str, str, str]]) -> str:
    """Aligned columns for the terminal, no directory column."""
    cells = [(qid, kind, state, stage, title) for qid, _, kind, state, stage, title in rows]
    heads = ("Id", "Kind", "State", "Stage", "Title")
    widths = [max(len(h), *(len(c[i]) for c in cells)) for i, h in enumerate(heads[:-1])]
    def fmt(c):
        return "  ".join(v.ljust(widths[i]) for i, v in enumerate(c[:-1])) + "  " + c[-1]
    return "\n".join([fmt(heads), fmt(tuple("-" * w for w in widths) + ("-----",))] + [fmt(c) for c in cells])


def write_log(root: Path) -> Path:
    qdir = quests_dir(root)
    qdir.mkdir(parents=True, exist_ok=True)
    path = qdir / "README.md"
    path.write_text(render_log(load_quests(qdir), plugin_commit()))
    return path


# --- format -----------------------------------------------------------------


def read_format(qdir: Path) -> int | None:
    """The format number in the quest log header. None when there is no log."""
    path = qdir / "README.md"
    if not path.is_file():
        return None
    m = HEADER_RE.search(path.read_text())
    return int(m.group(1)) if m else 0


def check_format(root: Path) -> None:
    """Refuse data newer than this script. Migrate data older than it."""
    qdir = quests_dir(root)
    found = read_format(qdir)
    if found is None:
        return
    if found > FORMAT:
        die(f"this repository was last written by a newer questlog (format {found}, this is {FORMAT}); update the plugin", 2)
    if found < FORMAT:
        migrate(root, found)


def migrate(root: Path, from_format: int) -> None:
    """Bring every quest.md up to FORMAT, then rewrite the log."""
    # format 3 changed the quest log from list lines to a table; write_log below is the migration.
    if from_format < 2:
        # format 2 added the plan stage between design and implement. Work that
        # had already reached implement never had a plan stage; record it as
        # skipped so it does not appear to be waiting there.
        stamp = now_iso()
        for d, fm in load_quests(quests_dir(root)):
            reached_implement = any(k.startswith("implement_") for k in fm) or fm.get("state") in ("done", "abandoned")
            if reached_implement and not any(k.startswith("plan_") for k in fm):
                update_quest(d, {"plan_skipped": stamp, "plan_note": "predates the plan stage (format 2)"})
    write_log(root)
    print(f"quest: migrated docs/quests from format {from_format} to {FORMAT}", file=sys.stderr)


# --- init and doctor --------------------------------------------------------


def cmd_init(args: argparse.Namespace) -> None:
    root = project_root()
    qdir = quests_dir(root)
    made = []
    if not qdir.is_dir():
        qdir.mkdir(parents=True)
        made.append(str(qdir.relative_to(root)) + "/")
    if not (qdir / "README.md").is_file():
        write_log(root)
        made.append(f"{ROOT_NAME}/README.md")
    claude_md = root / "CLAUDE.md"
    text = claude_md.read_text() if claude_md.is_file() else ""
    if CLAUDE_MD_MARK not in text:
        claude_md.write_text(text.rstrip("\n") + "\n" + CLAUDE_MD_PARAGRAPH if text else CLAUDE_MD_PARAGRAPH.lstrip("\n"))
        made.append("CLAUDE.md paragraph")
    git_add(root, [ROOT_NAME, "CLAUDE.md"])
    print("initialized: " + ", ".join(made) if made else "already initialized; nothing changed")
    for ok, label, fix in git_checks(root):
        if not ok:
            print(f"quest: {label} ({fix})")


REQUIRED_KEYS = ("id", "title", "kind", "state", "created")
PERSISTED = (ROOT_NAME, ".claude/settings.json", "CLAUDE.md")


def git_status_of(root: Path, path: str) -> str:
    """'tracked', 'untracked', 'ignored', 'missing', or 'no-git'."""
    try:
        subprocess.run(["git", "-C", str(root), "rev-parse", "--is-inside-work-tree"], capture_output=True, check=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        return "no-git"
    if not (root / path).exists():
        return "missing"
    if subprocess.run(["git", "-C", str(root), "check-ignore", "-q", path], capture_output=True).returncode == 0:
        return "ignored"
    tracked = subprocess.run(["git", "-C", str(root), "ls-files", "--error-unmatch", path], capture_output=True).returncode == 0
    return "tracked" if tracked else "untracked"


def git_checks(root: Path) -> list[tuple[bool, str, str]]:
    rows = []
    for path in PERSISTED:
        state = git_status_of(root, path)
        if state == "no-git":
            return [(False, "this directory is a git repository", "git init, then commit docs/quests/ and .claude/settings.json")]
        label = {"tracked": f"{path} is committed", "untracked": f"{path} is not committed", "ignored": f"{path} is ignored by git", "missing": f"{path} does not exist"}[state]
        fix = {"tracked": "", "untracked": f"git add {path} && git commit", "ignored": f"remove {path} from .gitignore, then git add it", "missing": "quest init" if path != ".claude/settings.json" else "enable the plugin in project settings so clones get it"}[state]
        rows.append((state == "tracked", label, fix))
    return rows


def git_add(root: Path, paths: list[str]) -> None:
    try:
        subprocess.run(["git", "-C", str(root), "add", "--", *[p for p in paths if (root / p).exists()]], capture_output=True, check=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass


def doctor_checks(root: Path) -> list[tuple[bool, str, str]]:
    """(ok, label, fix) rows. Pure; cmd_doctor prints and fixes."""
    rows = []
    qdir = quests_dir(root)
    if not qdir.is_dir():
        return [(False, f"{ROOT_NAME}/ exists", "quest init")]
    found = read_format(qdir)
    if found is None:
        rows.append((False, "quest log exists", "quest init"))
    elif found > FORMAT:
        rows.append((False, f"quest log format {found} is newer than this plugin's {FORMAT}", "update the plugin"))
    else:
        rows.append((True, f"quest log format {found}", ""))
    bad = 0
    for d in sorted(p for p in qdir.iterdir() if p.is_dir()):
        page = d / "quest.md"
        if not page.is_file():
            rows.append((False, f"{d.name}/ has no quest.md", "add one or remove the directory")); bad += 1; continue
        fm, _ = parse_page(page.read_text())
        missing = [k for k in REQUIRED_KEYS if k not in fm]
        if missing or fm.get("kind") not in KINDS or fm.get("state") not in STATES or not ID_RE.match(str(fm.get("id", ""))):
            rows.append((False, f"{d.name}/quest.md frontmatter invalid" + (f", missing {', '.join(missing)}" if missing else ""), "fix the frontmatter")); bad += 1
        elif not d.name.startswith(str(fm["id"])):
            rows.append((False, f"{d.name}/ does not start with its id {fm['id']}", "rename the directory")); bad += 1
    quests = load_quests(qdir)
    rows.append((bad == 0, f"{len(quests)} quest.md files valid", ""))
    if found is not None and found <= FORMAT:
        current = (qdir / "README.md").read_text()
        same = log_lines(quests) == [l for l in current.splitlines() if l.startswith("| [")]
        rows.append((same, "quest log matches the directories", "quest doctor --fix"))
    claude_md = root / "CLAUDE.md"
    rows.append((claude_md.is_file() and CLAUDE_MD_MARK in claude_md.read_text(), "CLAUDE.md has the quests paragraph", "quest init"))
    rows.extend(git_checks(root))
    return rows


def cmd_doctor(args: argparse.Namespace) -> None:
    root = project_root()
    qdir = quests_dir(root)
    if args.brief and not qdir.is_dir():
        print("questlog: this repository has no docs/quests/. Ask the creator whether to set up quests here; if yes, run `quest init`.")
        return
    rows = doctor_checks(root)
    if args.fix:
        for ok, label, fix in rows:
            if not ok and fix == "quest doctor --fix":
                write_log(root)
        rows = doctor_checks(root)
    failed = [r for r in rows if not r[0]]
    if args.brief:
        if failed:
            print("questlog: " + "; ".join(f"{label} ({fix})" if fix else label for _, label, fix in failed))
        else:
            n = len(log_lines(load_quests(qdir)))
            print(f"questlog: ok, {n} open. Run `quest log`.")
        sys.exit(0)
    for ok, label, fix in rows:
        print(f"{'ok  ' if ok else 'FAIL'} {label}" + (f"  ({fix})" if not ok and fix else ""))
    sys.exit(1 if failed else 0)


# --- memory ------------------------------------------------------------------


def memory_hits(query: str) -> list[str]:
    """Top three memory pages for a query, when the memory plugin is on PATH. Fail open."""
    if not shutil.which("memory"):
        return []
    try:
        proc = subprocess.run(["memory", "search", "--json", query], capture_output=True, text=True, timeout=8)
        rows = json.loads(proc.stdout[proc.stdout.find("["):]) if "[" in proc.stdout else []
    except (subprocess.SubprocessError, json.JSONDecodeError, OSError, ValueError):
        return []
    return [f"`memory read {r['filename']}` ({str(r.get('summary', ''))[:80]})" for r in rows[:3] if r.get("filename")]


def print_memory_hits(query: str) -> None:
    hits = memory_hits(query)
    if hits:
        print("memory: " + " · ".join(hits))


# --- transitions ------------------------------------------------------------

STAGE_FILES = {"goal": "goal.md", "research": "research.md", "design": "design.md", "plan": "plan.md"}


def update_quest(d: Path, changes: dict) -> dict:
    page = d / "quest.md"
    fm, body = parse_page(page.read_text())
    fm.update(changes)
    page.write_text(render_page(fm, body))
    return fm


def require_open(fm: dict) -> None:
    if fm.get("state") in ("done", "abandoned"):
        die(f"{fm['id']} is {fm['state']}; nothing more happens to it")


def require_stage(fm: dict, stage: str, verb: str) -> None:
    if fm.get("state") != "active":
        die(f"{fm['id']} is {fm.get('state')}; start it before you {verb} a stage")
    current = current_stage(fm)
    if stage not in STAGES[fm.get("kind", "quest")]:
        die(f"{fm.get('kind')} {fm['id']} has no {stage} stage")
    if current != stage:
        die(f"{fm['id']} is at {current}, not {stage}")


def cmd_start(args: argparse.Namespace) -> None:
    root = project_root()
    check_format(root)
    d, fm = resolve(quests_dir(root), args.id)
    require_open(fm)
    if fm.get("state") != "backlog":
        die(f"{fm['id']} is already {fm['state']}")
    update_quest(d, {"state": "active", "started": now_iso()})
    write_log(root)
    print(f"{fm['id']} active; current stage {current_stage(fm)}")
    print_memory_hits(str(fm.get("title", "")))


def cmd_draft(args: argparse.Namespace) -> None:
    root = project_root()
    check_format(root)
    d, fm = resolve(quests_dir(root), args.id)
    require_open(fm)
    require_stage(fm, args.stage, "draft")
    wanted = STAGE_FILES.get(args.stage)
    if wanted and not (d / wanted).is_file():
        die(f"write {d.name}/{wanted} before drafting {args.stage}")
    update_quest(d, {f"{args.stage}_drafted": now_iso()})
    write_log(root)
    print(f"{fm['id']} {args.stage} drafted; ask the creator whether the stage is complete")
    if args.stage in ("research", "design", "plan") and shutil.which("memory"):
        print(f"memory: what did you learn during {args.stage} on your own? One page per finding, `--ref {d.name}/{STAGE_FILES[args.stage]}`, before the creator closes it.")


def cmd_close(args: argparse.Namespace) -> None:
    root = project_root()
    check_format(root)
    d, fm = resolve(quests_dir(root), args.id)
    require_open(fm)
    require_stage(fm, args.stage, "close")
    changes = {f"{args.stage}_closed": now_iso()}
    if args.stage == "review":
        changes["state"] = "done"
    fm = update_quest(d, changes)
    write_log(root)
    nxt = current_stage(fm)
    print(f"{fm['id']} {args.stage} closed; " + (f"next stage {nxt}" if nxt else "done"))


def cmd_skip(args: argparse.Namespace) -> None:
    root = project_root()
    check_format(root)
    d, fm = resolve(quests_dir(root), args.id)
    require_open(fm)
    if args.stage != "research":
        die("only research can be skipped")
    require_stage(fm, "research", "skip")
    update_quest(d, {"research_skipped": now_iso()})
    write_log(root)
    print(f"{fm['id']} research skipped; next stage design")


def cmd_abandon(args: argparse.Namespace) -> None:
    root = project_root()
    check_format(root)
    d, fm = resolve(quests_dir(root), args.id)
    require_open(fm)
    reason = (args.reason or "").strip()
    if not reason:
        die("abandon needs a reason, in the creator's words")
    update_quest(d, {"state": "abandoned", "abandoned": now_iso(), "abandoned_reason": reason})
    write_log(root)
    print(f"{fm['id']} abandoned; files stay in {d.name}/")


# --- commands ---------------------------------------------------------------


def cmd_new(args: argparse.Namespace) -> None:
    root = project_root()
    check_format(root)
    qdir = quests_dir(root)
    qdir.mkdir(parents=True, exist_ok=True)
    kind = "chore" if args.chore else "quest"
    qid = new_id(existing_ids(qdir))
    d = qdir / f"{qid}-{slugify(args.title)}"
    d.mkdir()
    fm = {"id": qid, "title": args.title, "kind": kind, "state": "backlog", "created": now_iso()}
    body = quest_body(args.goal or "(what the creator wants to accomplish)", args.done_when or "(how we will know)")
    (d / "quest.md").write_text(render_page(fm, body))
    write_log(root)
    print(f"{kind} {qid} created at {d.relative_to(root)}/")


def cmd_log(args: argparse.Namespace) -> None:
    root = project_root()
    check_format(root)
    rows = log_rows(load_quests(quests_dir(root)))
    print(terminal_table(rows) if rows else "Nothing open.")


def cmd_show(args: argparse.Namespace) -> None:
    root = project_root()
    check_format(root)
    d, fm = resolve(quests_dir(root), args.id)
    sys.stdout.write((d / "quest.md").read_text())
    files = sorted(p.name for p in d.iterdir() if p.is_file() and p.name != "quest.md")
    print("\nstage files: " + (", ".join(files) if files else "none"))
    print(f"current stage: {current_stage(fm) or 'none, finished'}")
    print_memory_hits(str(fm.get("title", "")))


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(prog="quest", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("new", help="open a quest or chore (creator verb)")
    p.add_argument("title")
    p.add_argument("--chore", action="store_true", help="a small piece of work; starts at implement")
    p.add_argument("--goal", help="what the creator wants to accomplish")
    p.add_argument("--done-when", help="how we will know it is done")
    p.set_defaults(func=cmd_new)

    for verb, fn, helptext in (("start", cmd_start, "backlog to active (creator verb)"),):
        p = sub.add_parser(verb, help=helptext); p.add_argument("id"); p.set_defaults(func=fn)
    p = sub.add_parser("draft", help="record that a stage file is written and awaits review")
    p.add_argument("id"); p.add_argument("stage", choices=STAGES["quest"]); p.set_defaults(func=cmd_draft)
    p = sub.add_parser("close", help="the creator accepted the stage (creator verb)")
    p.add_argument("id"); p.add_argument("stage", choices=STAGES["quest"]); p.set_defaults(func=cmd_close)
    p = sub.add_parser("skip", help="the creator waived research (creator verb)")
    p.add_argument("id"); p.add_argument("stage"); p.set_defaults(func=cmd_skip)
    p = sub.add_parser("abandon", help="terminal, with a reason (creator verb)")
    p.add_argument("id"); p.add_argument("reason"); p.set_defaults(func=cmd_abandon)

    p = sub.add_parser("init", help="create docs/quests and the CLAUDE.md paragraph (creator verb)")
    p.set_defaults(func=cmd_init)
    p = sub.add_parser("doctor", help="check the tracker; --fix regenerates a stale log")
    p.add_argument("--fix", action="store_true"); p.add_argument("--brief", action="store_true", help="one line, nothing if no tracker")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("log", help="what is open, one line each")
    p.set_defaults(func=cmd_log)

    p = sub.add_parser("show", help="one quest's metadata and files")
    p.add_argument("id", help="identifier or a unique prefix")
    p.set_defaults(func=cmd_show)

    args = parser.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
